/// A verdict on whether one document is backed by what CGC ordered and received.
///
/// The verdict is never stored without `evidence`: the list of checks that were
/// run, what each compared, and what it found. A status with no evidence behind
/// it is how this system previously showed a green MATCHED badge that had been
/// hard-coded, so the two are stored together or not at all.
///
/// A result a person has resolved is theirs. Re-running matching replaces
/// unresolved rows and leaves resolved ones alone.
model MatchResult {
  id            String            @id @default(uuid()) @db.Uuid
  subjectType   MatchSubjectType
  ticketId      String?           @db.Uuid
  invoiceLineId String?           @db.Uuid
  orderId       String?           @db.Uuid
  status        MatchStatus
  /// Every check that ran, with its inputs and result. Rendered on the desk.
  evidence      Json
  /// One line summarising why this status was reached.
  reason        String
  /// Orders still plausible when the status is CONFLICT.
  candidateOrderIds String[]
  /// Tickets this verdict actually counted — what a resolution will claim.
  ticketIds     String[]          @default([])
  /// Dispatch loads a trucking invoice line's verdict counted: one load, or
  /// every load of one brokered trip. What a resolution claims on
  /// DispatchLoad.claimedByLineItemId; empty for material lines.
  loadIds       String[]          @default([])
  /// Bumped when the cascade changes, so old verdicts can be told apart.
  engineVersion Int               @default(1)
  computedAt    DateTime          @default(now())
  resolvedById  String?           @db.Uuid
  resolvedAt    DateTime?
  resolution    MatchResolution?
  resolutionNote String?

  ticket      Ticket?          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  invoiceLine InvoiceLineItem? @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  order       Order?           @relation(fields: [orderId], references: [id])
  resolvedBy  User?            @relation(fields: [resolvedById], references: [id])

  @@unique([ticketId])
  @@unique([invoiceLineId])
  @@index([status])
  @@index([orderId])
  @@index([status, computedAt])
}

enum MatchSubjectType {
  TICKET
  INVOICE_LINE
}

enum MatchStatus {
  MATCHED
  PARTIAL
  UNMATCHED
  CONFLICT
}

enum MatchResolution {
  CONFIRMED
  OVERRIDDEN
  REJECTED
}

/// A person's record that this delivery ticket paid one specific invoice line.
///
/// The engine never writes one of these. A claim is created only when somebody
/// CONFIRMS or OVERRIDES a line — the moment money is actually committed — and
/// released when that decision is rejected or reopened.
///
/// `ticketId` is unique, which is the whole mechanism: a load is one scale
/// reading and can pay for exactly one line. Before this existed, the same
/// 24.6 tonne ticket satisfied two invoice lines and both reported MATCHED.
model TicketClaim {
  id            String   @id @default(uuid()) @db.Uuid
  /// One load, one claim. This constraint is the protection.
  ticketId      String   @unique @db.Uuid
  invoiceLineId String   @db.Uuid
  /// The verdict this claim was made against, for tracing it back.
  matchResultId String?  @db.Uuid
  claimedById   String   @db.Uuid
  claimedAt     DateTime @default(now())

  ticket      Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  invoiceLine InvoiceLineItem @relation(fields: [invoiceLineId], references: [id], onDelete: Cascade)
  claimedBy   User            @relation(fields: [claimedById], references: [id])

  @@index([invoiceLineId])
}
