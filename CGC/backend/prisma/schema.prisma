generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One Spruce document — what the yard calls an order.
///
/// `Order` is a single line item, keyed by `spruceOrderId`, which is
/// synthesised from where the row happened to sit in the uploaded PDF
/// (`123456-P2-T2-4`). Two consequences followed from that: the delivery report
/// and the PO report could not be joined, because neither stores the document
/// number as a key; and re-importing a regenerated report shifted every row
/// below an insertion onto a new key, duplicating orders that already existed.
///
/// This model holds the document number itself, so there is something real to
/// join on and something stable to re-import against. It is additive: `Order`
/// keeps its own id and every existing foreign key still resolves.
model OrderDocument {
  id              String    @id @default(uuid()) @db.Uuid
  /// The Spruce document number, as printed. The join key for both reports.
  documentNumber  String    @unique
  customerName    String
  /// Filled by the delivery report, or later by the PO report merge.
  poNumber        String?
  /// Null until someone establishes how this customer buys — never guessed.
  /// The reports do not say, and stamping CONTRACTOR on every document hid the
  /// walk-in trade entirely.
  buyerType       BuyerType?
  orderDate       DateTime? @db.Date
  deliveryDate    DateTime? @db.Date
  shippingAddress String?

  // Merged from the three Spruce reports by `mergeOrderFacts`. Each field has
  // one report that wins when they disagree; see that function.

  accountCode          String?
  /// The account's own name where it differs from the person ("Cash Sales").
  accountName          String?
  /// As printed, extension included.
  phone                String?
  route                String?
  cashier              String?
  /// Spruce's status word as the winning report printed it ("Open", "Sched").
  spruceStatus         String?
  /// "SCH" where the order summary marks a scheduled delivery.
  deliveryFlag         String?
  totalWithTax         Decimal?  @db.Decimal(12, 2)
  /// The order summary's "Remaining". Equals the pre-tax subtotal on every
  /// sample, but that is unconfirmed, so it keeps Spruce's name.
  remaining            Decimal?  @db.Decimal(12, 2)
  /// The order summary's "Rem Dep". Meaning unconfirmed.
  remainingDeposit     Decimal?  @db.Decimal(12, 2)
  grossMarginPct       Decimal?  @db.Decimal(7, 2)
  deliveryInstructions String?
  deliveryTruck        String?
  orderNotes           String?
  /// `shippingAddress` with Spruce's stray commas tidied. Never invented.
  addressNormalized    String?
  /// SLINGER, SPLITBOX, FLATBED, DUMP, BAG or GENERAL, read off the item codes.
  deliveryType         String?
  /// Collected from the yard rather than delivered. Never on the dispatch board.
  isPickup             Boolean   @default(false)
  /// Things a dispatcher should look at, e.g. NO_ADDRESS, TOTAL_MISMATCH.
  flags                String[]  @default([])
  /// Which reports have ever described this order.
  sourceReports        String[]  @default([])
  /// The import batch that last described this order.
  lastBatchId          String?   @db.Uuid
  lastBatch            ImportBatch? @relation(fields: [lastBatchId], references: [id], onDelete: SetNull)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lines           Order[]
  /// The stop that delivers this order, once it is dispatched.
  delivery        Delivery?
  /// A dispatcher's note for the driver. Ours, not Spruce's: no report writes it.
  dispatcherNotes String?
  /// How the order reaches the customer when dispatch says otherwise than the
  /// reports: yard_pickup, yard_delivery, supplier_haul_delivery,
  /// external_pickup or supplier_direct_ship. Ours, like dispatcherNotes; null
  /// means "as the reports say". Office screens only, never a driver's.
  fulfilmentOverride String?
  /// The pit or supplier dispatch chose to load at, where the order names none
  /// (a "PitBlk" order with no PO). Office screens only; the driver is told
  /// its name and address as the place to pick up, and nothing else of it.
  pickupSupplierId String?   @db.Uuid
  pickupSupplier   Supplier? @relation("OrderPickupSupplier", fields: [pickupSupplierId], references: [id], onDelete: SetNull)
  /// Which of that supplier's yards or pits, where it has several: "Ayr".
  pickupLocation   String?
  /// Fields a dispatcher has corrected. The columns above hold the corrected
  /// value; each override keeps what Spruce says.
  overrides       OrderOverride[]
  /// What Spruce changed on this order when its reports were uploaded again.
  changes         OrderChange[]
  /// The trucks dispatch sent for this order, each with the haul rate agreed
  /// for it. Office screens only, never a driver's.
  dispatchLoads   DispatchLoad[]

  @@index([orderDate])
  @@index([deliveryDate])
  @@index([poNumber])
  @@index([pickupSupplierId])
}

model Order {
  id             String             @id @default(uuid()) @db.Uuid
  spruceOrderId  String             @unique
  /// Owning document. Nullable while the backfill runs and for rows imported
  /// by the legacy path; new imports always set it.
  documentId     String?            @db.Uuid
  /// Position of this line within its document, 1-based. Display order only:
  /// the reports print the same document's lines in different orders, so a
  /// re-import reconciles on `spruceItemNumber` and never on this number.
  lineNumber     Int?
  /// Spruce item code as printed on the line, e.g. `SOILGRDNA`. The stable
  /// cross-report identity: the same code appears for the same line in every
  /// report layout, so a re-import pairs it with its earlier row wherever the
  /// reports happened to print them. Null only for legacy rows awaiting their
  /// first post-migration re-import, which fills it from the report.
  spruceItemNumber String?
  poNumber       String?
  customerName   String
  /// Spruce's delivery report does not distinguish a contractor sale from a
  /// walk-in, and the importer stamped CONTRACTOR on every row — so the B2C
  /// side of the business appeared nowhere. Defaulted rather than asserted:
  /// B2B is roughly 90% of volume, so this is the right guess, but it is a
  /// default to be corrected, not a fact read off the report.
  buyerType      BuyerType?         @default(CONTRACTOR)
  product        String
  quantity       Decimal?           @db.Decimal
  unit           String?
  /// Selling price per unit, from the order summary. Never shown to drivers.
  unitPrice      Decimal?           @db.Decimal(12, 4)
  /// Cost per unit, from the order summary. Never shown to drivers.
  unitCost       Decimal?           @db.Decimal(12, 4)
  /// PRODUCT, DELIVERY_CHARGE, DEPOSIT, COMMENT or SURCHARGE.
  lineClass      String?
  /// Spruce vendor code the PO was raised on, e.g. `UNILOCKL01`, as printed.
  vendorCode     String?
  /// Where the PO's vendor ships from, from the item tracking report.
  vendorLocation String?
  /// Value of the whole PO this line was bought under.
  poValue        Decimal?           @db.Decimal(12, 2)
  supplierId     String?            @db.Uuid
  orderDate      DateTime?          @db.Date
  deliveryDate   DateTime?          @db.Date
  hasInvoice     Boolean            @default(false)
  invoiceNumber  String?
  createdAt      DateTime           @default(now())
  deliveryStatus DriverTaskStatus   @default(NOT_STARTED)
  driverId       String?            @db.Uuid
  priority       Int                @default(1)
  deliveries     Delivery[]
  lineItems      InvoiceLineItem[]
  driver         Driver?            @relation(fields: [driverId], references: [id])
  supplier       Supplier?          @relation(fields: [supplierId], references: [id])
  document       OrderDocument?     @relation(fields: [documentId], references: [id])
  overrides      OrderOverride[]
  changes        OrderChange[]
  tickets        Ticket[]
  ticketMatches  TicketOrderMatch[]
  matchResults   MatchResult[]

  /// The identity a re-import reconciles on, once the document layer is
  /// populated. `lineNumber` is display order, not identity.
  @@unique([documentId, lineNumber])
  @@index([poNumber])
  @@index([supplierId])
  @@index([orderDate])
  @@index([documentId])
  @@index([spruceItemNumber])
}


model Ticket {
  id                      String             @id @default(uuid()) @db.Uuid
  ticketNumber            String?
  source                  TicketSource
  supplierId              String?            @db.Uuid
  supplierName            String?
  poNumber                String?
  /// Ticket and PO numbers reduced to lower-case letters and digits, so search
  /// finds "T-88213" from "T88213" or "#t 88213". A database trigger recomputes
  /// it on every write (migration 20260915120000_ticket_number_search_key), so
  /// anything the application writes here is discarded.
  numberSearchKey         String?
  material                String?
  quantity                Decimal?           @db.Decimal
  unit                    String?
  rateOnTicket            Decimal?           @db.Decimal
  ticketDate              DateTime?          @db.Date
  imageUrl                String
  /// Small derived WebP for list/mobile rendering. Nullable: generation is
  /// best-effort and must never block a proof-of-delivery upload. Null means
  /// "not generated yet" and the UI falls back to imageUrl.
  thumbnailUrl            String?
  ocrRawText              String
  ocrConfidence           Float
  linkedOrderId           String?            @db.Uuid
  linkMethod              String?
  linkedById              String?            @db.Uuid
  status                  TicketStatus
  receivedAt              DateTime           @default(now())
  driverId                String?            @db.Uuid
  deliveryStatus          DriverTaskStatus   @default(NOT_STARTED)
  spruceMatched           Boolean            @default(false)
  /// Set on a second copy of a load already on file: the supplier's emailed
  /// copy of a ticket the driver also photographed (A15), or the same ticket
  /// sent twice. Points at the copy that counts (the driver's when there is
  /// one), so matching counts the load once and a claim on either copy is a
  /// claim on the load. Same supplier and same ticket number decide it
  /// (modules/tickets/ticketCopies.ts).
  duplicateOfTicketId     String?            @db.Uuid
  /// For a ticket cut from an emailed attachment: `messageId:partId#page`, so
  /// a mailbox poll that is retried never files the same page twice.
  emailSourceKey          String?            @unique
  duplicateOf             Ticket?            @relation("TicketCopies", fields: [duplicateOfTicketId], references: [id], onDelete: SetNull)
  copies                  Ticket[]           @relation("TicketCopies")
  ocrJobs                 OcrJob[]           @relation("TicketOcrJobs")
  matchResult             MatchResult?
  claim                   TicketClaim?
  driver                  Driver?            @relation(fields: [driverId], references: [id])
  linkedBy                User?              @relation(fields: [linkedById], references: [id])
  linkedOrder             Order?             @relation(fields: [linkedOrderId], references: [id])
  supplier                Supplier?          @relation(fields: [supplierId], references: [id])
  orderMatches            TicketOrderMatch[]
  matchedInvoiceLineItems InvoiceLineItem[]  @relation("InvoiceLineItemToTicket")

  @@index([status])
  @@index([poNumber])
  @@index([supplierId])
  @@index([receivedAt])
  // The list screen filters on status and sorts by receivedAt desc, a shape a
  // single-column index does not support. Effect on the query plan is
  // unverified — no EXPLAIN ANALYZE was captured.
  @@index([status, receivedAt(sort: Desc)])
  @@index([supplierId, receivedAt(sort: Desc)])
  @@index([duplicateOfTicketId])
}


model TicketOrderMatch {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  orderId     String   @db.Uuid
  matchMethod String
  matchedAt   DateTime @default(now())
  createdBy   String?  @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, orderId])
  @@index([matchMethod])
  @@index([orderId])
  @@index([ticketId])
}

model Invoice {
  id             String               @id @default(uuid()) @db.Uuid
  invoiceNumber  String
  senderType     SenderType
  supplierId     String               @db.Uuid
  invoiceDate    DateTime             @db.Date
  dueDate        DateTime?            @db.Date
  totalAmount    Decimal              @db.Decimal
  currency       String
  fileUrl        String
  emailFrom      String
  emailSubject   String
  gmailMessageId String               @unique
  status         InvoiceStatus        @default(PENDING_REVIEW)
  verifiedById   String?              @db.Uuid
  verifiedAt     DateTime?
  disputeNote    String?
  receivedAt     DateTime             @default(now())
  ocrRawText     String?
  OcrJobStatus   OcrJobStatus         @default(PENDING)
  emailEvent     EmailIngestionEvent?
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  verifiedBy     User?                @relation(fields: [verifiedById], references: [id])
  lineItems      InvoiceLineItem[]
  ocrJobs        OcrJob[]             @relation("InvoiceOcrJobs")
  supportingFiles InvoiceSupportingFile[]

  @@index([status])
  @@index([supplierId])
  @@index([receivedAt])
  // Same filter+sort shape as Ticket: the invoice list filters on status and
  // orders by receivedAt desc.
  @@index([status, receivedAt(sort: Desc)])
}

/// A file that came with an invoice but is not one: the Excel load breakdown a
/// supplier attaches beside the PDF invoice (A12). Kept with its real content
/// type so the office can download it from the invoice; never read as a second
/// invoice, which would bill the same loads twice.
model InvoiceSupportingFile {
  id           String   @id @default(uuid()) @db.Uuid
  invoiceId    String   @db.Uuid
  fileUrl      String
  originalName String
  contentType  String
  size         Int
  /// `messageId:partId` of the email attachment it came from, so a retried
  /// poll does not attach it twice.
  gmailKey     String?  @unique
  createdAt    DateTime @default(now())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}


model InvoiceLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  invoiceId       String       @db.Uuid
  lineNumber      Int
  poNumber        String?
  description     String
  quantity        Decimal      @db.Decimal
  unit            String
  unitRate        Decimal      @db.Decimal
  lineTotal       Decimal      @db.Decimal
  matchedOrderId  String?      @db.Uuid
  negotiatedRate  Decimal?     @db.Decimal
  rateDiscrepancy Decimal?     @db.Decimal
  qtyDiscrepancy  Decimal?     @db.Decimal
  approvedTotal   Decimal?     @db.Decimal
  flag            LineItemFlag
  isOverridden    Boolean      @default(false)
  overrideNote    String?
  /// The ticket or load number a trucking invoice prints on this line, as
  /// read. Matched on its letters and digits (`numberSearchKey`), the same
  /// reduction ticket search uses. Null on most material invoices.
  ticketNumber    String?
  /// The day the line's load or trip was hauled, where the invoice prints one
  /// per line. Anchors the date window for finding the dispatch load.
  serviceDate     DateTime?    @db.Date
  invoice         Invoice      @relation(fields: [invoiceId], references: [id])
  matchedOrder    Order?       @relation(fields: [matchedOrderId], references: [id])
  matchedTickets  Ticket[]     @relation("InvoiceLineItemToTicket")
  matchResult     MatchResult?
  ticketClaims    TicketClaim[]
  /// The dispatch loads this line pays for (a trucking invoice's haul line).
  claimedLoads    DispatchLoad[]

  @@index([invoiceId])
  @@index([poNumber])
}


/// One agreed price for one product, in one unit, over one period.
///
/// A rate is identified by supplier, product, canonical unit and its effective
/// period. A new price does not overwrite the old one: the old period is closed
/// the day before the new one starts, so an invoice dated earlier is still
/// checked against the price that applied then.
model NegotiatedRate {
  id               String    @id @default(uuid()) @db.Uuid
  supplierId       String    @db.Uuid
  productName      String
  rate             Decimal   @db.Decimal
  unit             String
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  notes            String?
  /// The Spruce item number for this product (`Order.spruceItemNumber`), when
  /// the price list gives one. Lets a later lookup find the rate by code.
  spruceItemCode   String?
  /// The supplier's own code for the product, as printed on their paperwork.
  supplierItemCode String?
  createdById      String    @db.Uuid
  createdAt        DateTime  @default(now())
  /// Null on rows written before this column existed.
  updatedAt        DateTime? @updatedAt
  createdBy        User      @relation(fields: [createdById], references: [id])
  supplier         Supplier  @relation(fields: [supplierId], references: [id])

  @@index([supplierId, effectiveFrom])
  @@index([supplierId, spruceItemCode])
}

model Supplier {
  id              String                @id @default(uuid()) @db.Uuid
  name            String
  type            SupplierType
  emailDomains    String[]
  /// Exact sender addresses this supplier emails from, e.g.
  /// `billing@stone.example`. Needed for senders on shared mail services
  /// (gmail.com, outlook.com…), whose domain must never identify anyone.
  emailAddresses  String[]              @default([])
  contactName     String?
  contactEmail    String?
  phone           String?
  address         String?
  active          Boolean               @default(true)
  keywords        String[]
  /// The vendor codes Spruce prints on its reports for this supplier, e.g.
  /// `BESTWAYS01`. Reports name vendors by code, not by the supplier's stored
  /// name, so matching one against the other guessed wrong; this mapping is
  /// recorded once by a person and is exact thereafter.
  spruceVendors   SupplierSpruceVendor[]
  emailEvents     EmailIngestionEvent[]
  invoices        Invoice[]
  negotiatedRates NegotiatedRate[]
  orders          Order[]
  /// Orders dispatch chose this supplier's yard or pit to load at.
  pickupOrders    OrderDocument[] @relation("OrderPickupSupplier")
  /// Loads this trucking company hauled for CGC.
  haulLoads       DispatchLoad[]  @relation("DispatchLoadCarrier")
  /// Loads collected at this supplier's yard or pit.
  sourcedLoads    DispatchLoad[]  @relation("DispatchLoadSource")
  productAliases  SupplierProductAlias[]
  tickets         Ticket[]
}

/// Maps a Spruce vendor code to the supplier it bills as.
///
/// The item-tracking report names the vendor as a code (`BESTWAYS01`,
/// `UNILOCKL01`), which matches no supplier's stored name, so every such line
/// imported with no supplier at all — and invoice matching, which needs both
/// PO and supplier, never fired. A person records the code once; the importer
/// resolves it exactly or leaves the line unlinked and says so.
model SupplierSpruceVendor {
  code       String   @id
  supplierId String   @db.Uuid
  /// Retired codes are kept but no longer resolve, so an old report
  /// re-imported after a supplier change cannot silently re-point at it.
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

/// Maps the wording a supplier prints on their paperwork to the product name
/// used in that supplier's negotiated rates.
///
/// Rates were matched to invoice lines by string similarity, where a 0.6 score
/// or a substring hit counted as the same product. "A Gravel" and "B Gravel"
/// score far above that, so the wrong rate could be applied to real money. An
/// alias is recorded once by a person and is exact thereafter; fuzzy matching
/// stays only as the fallback for text nobody has mapped yet.
model SupplierProductAlias {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @db.Uuid
  /// Supplier's wording, normalised (lower case, punctuation collapsed).
  aliasText   String
  /// Must equal a NegotiatedRate.productName for the same supplier.
  productName String
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  supplier    Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, aliasText])
  @@index([supplierId])
}

model User {
  name             String
  email            String            @unique
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  passwordHash     String
  phone            String?
  role             UserRole
  id               String            @id @default(uuid()) @db.Uuid
  auditLogs        AuditLog[]
  verifiedInvoices Invoice[]
  createdRates     NegotiatedRate[]
  spruceImports    SpruceImportJob[]
  importBatches    ImportBatch[]
  orderOverrides   OrderOverride[]
  systemSettings   SystemSetting[]
  resolvedMatches  MatchResult[]
  ticketClaims     TicketClaim[]
  linkedTickets    Ticket[]
  reviewedEmailEvents EmailIngestionEvent[] @relation("EmailEventReviewer")
  dispatchLoads    DispatchLoad[]
  driver           Driver?
}

model Driver {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  phone           String            @unique
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  email           String?           @unique
  ratePerDelivery Decimal           @default(0) @db.Decimal
  ratePerTrip     Decimal?          @db.Decimal
  type            DriverType        @default(CGC_FLEET)
  companyName     String?
  deliveries      Delivery[]
  orders          Order[]
  tickets         Ticket[]
  messages        WhatsAppMessage[]
  dispatchLoads   DispatchLoad[]
  userId          String?           @db.Uuid @unique
  user            User?             @relation(fields: [userId], references: [id])
}

/// One stop on a driver's run.
///
/// A stop is a whole Spruce order (`document`). `order` is one of its lines —
/// the first product line — kept because tickets, matching and the driver's
/// phone still read a delivery through a line. Stops made before orders were
/// dispatched whole have a line and no document.
model Delivery {
  id               String            @id @default(uuid()) @db.Uuid
  orderId          String            @db.Uuid
  /// The Spruce order this stop delivers. One stop per order.
  documentId       String?           @unique @db.Uuid
  document         OrderDocument?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  driverId         String?           @db.Uuid
  status           DeliveryStatus    @default(UNASSIGNED)
  priority         Int               @default(1)
  pickupType       String            @default("EXTERNAL")
  pickupPhotoUrl   String?
  deliveryPhotoUrl String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  driver           Driver?           @relation(fields: [driverId], references: [id])
  order            Order             @relation(fields: [orderId], references: [id])
  history          DeliveryHistory[]
  /// The loads dispatch recorded for this stop. Never selected for a driver.
  dispatchLoads    DispatchLoad[]
}

/// How a haul rate is charged.
enum HaulRateUnit {
  LOAD
  HOUR
  TONNE
}

/// One truck load dispatch sent for an order, and the haul rate agreed for it.
///
/// The client (Oct 2026): "a spot for a rate on every single dispatch load. The
/// dispatcher sets the rate for each load dispatched and it is matched up when
/// the invoice comes in." So the rate is recorded per load from day one, before
/// any trucking invoice is read; matching those invoices against it is a later
/// change, which is why `claimedByLineItemId` is here already.
///
/// An order can need several loads (several trucks, or one truck several
/// times), each from its own pit. The rate is kept off Delivery on purpose:
/// stops reach drivers through several selects and the realtime feed, and a
/// driver must never see what a haul costs.
///
/// A brokered truck that collects several orders' POs in one trip (client,
/// A4) is one load per order sharing a `tripRef`. The rate on each of them is
/// the trip's rate, the same on every load of the trip, not a share of it: the
/// trip is billed once, so the matcher compares one billed line with that rate
/// and claims every load of the trip together (see `billableHauls`).
model DispatchLoad {
  id                  String           @id @default(uuid()) @db.Uuid
  documentId          String           @db.Uuid
  document            OrderDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  /// The order's stop, once it has one. Cleared, not cascaded, if the stop goes.
  deliveryId          String?          @db.Uuid
  delivery            Delivery?        @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  /// 1, 2, 3… within the order. A number is not reused while its load exists,
  /// so "load 2" written on paper keeps meaning the same truck.
  sequence            Int
  /// The trucking company that hauled it (a TRUCKING_COMPANY supplier); null
  /// for CGC's own trucks, which are recorded but never billed to CGC.
  /// Suppliers are only ever deactivated, and the key is not cleared on a
  /// delete either: a paid haul must keep its carrier.
  carrierSupplierId   String?          @db.Uuid
  carrierSupplier     Supplier?        @relation("DispatchLoadCarrier", fields: [carrierSupplierId], references: [id], onDelete: Restrict)
  /// The truck, for a brokered or independent driver on the board.
  driverId            String?          @db.Uuid
  driver              Driver?          @relation(fields: [driverId], references: [id], onDelete: SetNull)
  /// The haul rate agreed for this load, before tax. Null until dispatch sets it.
  rate                Decimal?         @db.Decimal(12, 4)
  /// Per load, per hour or per tonne. Required whenever `rate` is set.
  rateUnit            HaulRateUnit?
  /// Expected loads, hours or tonnes, in `rateUnit`.
  quantity            Decimal?         @db.Decimal(12, 4)
  /// The pit or supplier yard this load is collected at. Defaults to the
  /// order's pit (`OrderDocument.pickupSupplierId`) when the load is made.
  sourceSupplierId    String?          @db.Uuid
  sourceSupplier      Supplier?        @relation("DispatchLoadSource", fields: [sourceSupplierId], references: [id], onDelete: SetNull)
  /// Groups the loads of one brokered trip that served several orders.
  tripRef             String?
  /// The scale or delivery ticket for this load, once known.
  ticketNumber        String?
  notes               String?
  setById             String           @db.Uuid
  setBy               User             @relation(fields: [setById], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  /// The trucking invoice line that paid this load. Set by matching; once set,
  /// the load's figures are locked so a paid haul cannot be re-priced.
  claimedByLineItemId String?          @db.Uuid
  claimedByLineItem   InvoiceLineItem? @relation(fields: [claimedByLineItemId], references: [id], onDelete: SetNull)
  claimedAt           DateTime?

  @@unique([documentId, sequence])
  @@index([carrierSupplierId, createdAt])
  @@index([tripRef])
  @@index([claimedByLineItemId])
  @@index([deliveryId])
}

model AuditLog {
  id            String          @id @default(uuid()) @db.Uuid
  entityType    AuditEntityType
  entityId      String
  actionType    AuditActionType
  performedById String?         @db.Uuid
  details       Json?
  createdAt     DateTime        @default(now())
  performedBy   User?           @relation(fields: [performedById], references: [id])
}

model SpruceImportJob {
  id           String                 @id @default(uuid()) @db.Uuid
  uploadedById String                 @db.Uuid
  fileUrl      String
  startedAt    DateTime               @default(now())
  finishedAt   DateTime?
  status       ImportStatus           @default(PENDING)
  totalRows    Int                    @default(0)
  createdCount Int                    @default(0)
  updatedCount Int                    @default(0)
  unchangedCount Int                  @default(0)
  absentCount  Int                    @default(0)
  conflictCount Int                   @default(0)
  skippedCount Int                    @default(0)
  errorSummary String?
  uploadedBy   User                   @relation(fields: [uploadedById], references: [id])
  rowErrors    SpruceImportRowError[]
}

/// One morning's upload of the three Spruce reports.
///
/// The reports are only useful together: the delivery report says what goes
/// out, the order summary what it costs, the item tracking report where it
/// goes. A batch records which files were read, what was found in each, and
/// what the merge concluded, so a day can be explained and re-read later.
model ImportBatch {
  id           String            @id @default(uuid()) @db.Uuid
  /// The day being dispatched, in Cambridge.
  dispatchDate DateTime          @db.Date
  status       ImportBatchStatus @default(PROCESSING)
  createdById  String            @db.Uuid
  createdAt    DateTime          @default(now())
  finishedAt   DateTime?
  /// What the dispatcher was told: counts, issues, warnings.
  summary      Json?
  createdBy    User              @relation(fields: [createdById], references: [id])
  files        ImportBatchFile[]
  documents    OrderDocument[]

  @@index([dispatchDate])
}

/// A dispatcher's correction to what Spruce says about an order.
///
/// Spruce is often incomplete — no address, a project name for one, a missing
/// town — and it is the source of truth only for what it knows. The corrected
/// value is written into the order's own column, so every screen and the
/// driver's phone show it without knowing overrides exist. This row keeps
/// Spruce's value beside it, and a later import that brings a different one
/// records it here and puts the correction back rather than losing it.
model OrderOverride {
  id                String        @id @default(uuid()) @db.Uuid
  documentId        String        @db.Uuid
  /// The line corrected, or null for a field of the order itself.
  lineId            String?       @db.Uuid
  /// `lineId` or "ORDER", so one override per field and line is enforceable.
  targetKey         String
  field             String
  /// The corrected value, as text.
  value             String?
  /// What Spruce says now. Updated by every import that prints the field.
  spruceValue       String?
  /// What Spruce said when the correction was made.
  spruceValueAtEdit String?
  /// Spruce has changed its mind since the correction; someone should look.
  spruceChanged     Boolean       @default(false)
  editedById        String        @db.Uuid
  editedAt          DateTime      @default(now())
  document          OrderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  line              Order?        @relation(fields: [lineId], references: [id], onDelete: Cascade)
  editedBy          User          @relation(fields: [editedById], references: [id])

  @@unique([documentId, targetKey, field])
  @@index([documentId])
}

/// A value Spruce changed on an order that already existed, written by the
/// upload that brought it.
///
/// A re-upload later the same day refreshes orders in place; this is how the
/// dispatcher learns what moved. Only the fields a driver works from are kept
/// here, never money. Values are text in the same form as `OrderOverride`:
/// dates `YYYY-MM-DD`, quantities plain decimals, null for "nothing". On a
/// field the dispatcher has corrected, the values are Spruce's, not the
/// correction.
model OrderChange {
  id         String        @id @default(uuid()) @db.Uuid
  documentId String        @db.Uuid
  /// The line changed, or null for a field of the order itself.
  lineId     String?       @db.Uuid
  /// The import batch that brought the change. Not a foreign key, so the log
  /// outlives the batch.
  batchId    String?       @db.Uuid
  /// The column changed (`shippingAddress`, `quantity`), or `lineAdded` /
  /// `lineRemoved` for a whole line.
  field      String
  oldValue   String?
  newValue   String?
  createdAt  DateTime      @default(now())
  document   OrderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  line       Order?        @relation(fields: [lineId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([lineId])
}

/// One report within a batch, with everything read from it.
model ImportBatchFile {
  id              String      @id @default(uuid()) @db.Uuid
  batchId         String      @db.Uuid
  /// ORDER_SUMMARY, DELIVERY or ITEM_TRACKING.
  reportType      String
  fileName        String
  /// SHA-256 of the bytes, so the same file is recognised when uploaded again.
  fileHash        String
  pageCount       Int
  /// The date range the report says it was filtered on.
  reportDateFrom  DateTime?   @db.Date
  reportDateTo    DateTime?   @db.Date
  rowCount        Int
  documentCount   Int
  unreadableCount Int
  /// The parsed rows, so the day can be re-merged without the PDF.
  extraction      Json
  createdAt       DateTime    @default(now())
  batch           ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([fileHash])
}

enum ImportBatchStatus {
  PROCESSING
  DONE
  FAILED
}

model SpruceImportRowError {
  id           String          @id @default(uuid()) @db.Uuid
  importJobId  String          @db.Uuid
  rowNumber    Int
  rawRowData   String
  errorMessage String
  importJob    SpruceImportJob @relation(fields: [importJobId], references: [id])
}

model OcrJob {
  id           String       @id @default(uuid()) @db.Uuid
  provider     OcrProvider
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  rawResponse  Json?
  ticketId     String?      @db.Uuid
  invoiceId    String?      @db.Uuid
  type         OcrJobType
  status       OcrJobStatus @default(PENDING)
  /// How many times this job has been attempted. The worker only picked up
  /// PENDING jobs, so a single Textract timeout left the document FAILED and
  /// unprocessed forever, with nothing on any screen to say so.
  attempts     Int          @default(0)
  /// Earliest time the worker may try again; spaces out retries after a failure.
  nextAttemptAt DateTime?
  invoice      Invoice?     @relation("InvoiceOcrJobs", fields: [invoiceId], references: [id])
  ticket       Ticket?      @relation("TicketOcrJobs", fields: [ticketId], references: [id])

  /// The worker's claim query: status plus when the job is next due.
  @@index([status, nextAttemptAt])
}

/// One row per email the invoice inbox poller has looked at: the mailbox log.
///
/// It is also the review queue. Mail from a sender no supplier record knows,
/// or carrying nothing the app can read, is kept here as NEEDS_REVIEW instead
/// of being skipped without a trace, and the office approves the sender or
/// ignores the email from the Invoices page.
model EmailIngestionEvent {
  id                 String               @id @default(uuid()) @db.Uuid
  gmailMessageId     String               @unique
  subject            String
  fromAddress        String
  toAddress          String
  supplierId         String?              @db.Uuid
  senderTypeResolved SenderTypeResolved?
  createdInvoiceId   String?              @unique @db.Uuid
  createdTicketIds   String[]
  status             EmailIngestionStatus @default(PROCESSED)
  errorMessage       String?
  receivedAt         DateTime             @default(now())
  /// Who really sent it, after undoing the AP mailbox's forward; null when
  /// that could not be established (services/emailSender.ts).
  originalFrom       String?
  /// The trusted forwarder that relayed it, e.g. the AP mailbox.
  forwardedBy        String?
  /// direct | redirect | forward | unknown, as resolveSender decided.
  senderMode         String?
  /// Every attachment and what happened to it:
  /// [{ name, mimeType, size, partId, kind, action, reason, invoiceId }].
  /// Nothing is skipped without a line here saying why.
  attachments        Json?
  /// Every invoice this email produced. One email can carry several, which
  /// the single unique `createdInvoiceId` cannot hold.
  createdInvoiceIds  String[]             @default([])
  /// Why a NEEDS_REVIEW email waits for a person: UNKNOWN_SENDER,
  /// UNRESOLVED_SENDER, SPREADSHEET (one the app cannot read, e.g. .xls),
  /// CREDIT_MEMO, UNSUPPORTED_ATTACHMENTS or NO_INVOICE_ATTACHMENT.
  reviewReason       String?
  /// A plain note about the email, e.g. the observe-mode census line.
  note               String?
  /// Set when the sender is approved: the poller reads the email again.
  requeuedAt         DateTime?
  reviewedById       String?              @db.Uuid
  reviewedAt         DateTime?
  createdInvoice     Invoice?             @relation(fields: [createdInvoiceId], references: [id])
  supplier           Supplier?            @relation(fields: [supplierId], references: [id])
  reviewedBy         User?                @relation("EmailEventReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  /// The review queue on the Invoices page, newest first.
  @@index([status, receivedAt])
}

