generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One Spruce document — what the yard calls an order.
///
/// `Order` is a single line item, keyed by `spruceOrderId`, which is
/// synthesised from where the row happened to sit in the uploaded PDF
/// (`123456-P2-T2-4`). Two consequences followed from that: the delivery report
/// and the PO report could not be joined, because neither stores the document
/// number as a key; and re-importing a regenerated report shifted every row
/// below an insertion onto a new key, duplicating orders that already existed.
///
/// This model holds the document number itself, so there is something real to
/// join on and something stable to re-import against. It is additive: `Order`
/// keeps its own id and every existing foreign key still resolves.
model OrderDocument {
  id              String    @id @default(uuid()) @db.Uuid
  /// The Spruce document number, as printed. The join key for both reports.
  documentNumber  String    @unique
  customerName    String
  /// Filled by the delivery report, or later by the PO report merge.
  poNumber        String?
  /// Null until someone establishes how this customer buys — never guessed.
  /// The reports do not say, and stamping CONTRACTOR on every document hid the
  /// walk-in trade entirely.
  buyerType       BuyerType?
  orderDate       DateTime  @db.Date
  deliveryDate    DateTime? @db.Date
  shippingAddress String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lines           Order[]

  @@index([orderDate])
  @@index([poNumber])
}

model Order {
  id             String             @id @default(uuid()) @db.Uuid
  spruceOrderId  String             @unique
  /// Owning document. Nullable while the backfill runs and for rows imported
  /// by the legacy path; new imports always set it.
  documentId     String?            @db.Uuid
  /// Position of this line within its document, 1-based. Display order only:
  /// the reports print the same document's lines in different orders, so a
  /// re-import reconciles on `spruceItemNumber` and never on this number.
  lineNumber     Int?
  /// Spruce item code as printed on the line, e.g. `SOILGRDNA`. The stable
  /// cross-report identity: the same code appears for the same line in every
  /// report layout, so a re-import pairs it with its earlier row wherever the
  /// reports happened to print them. Null only for legacy rows awaiting their
  /// first post-migration re-import, which fills it from the report.
  spruceItemNumber String?
  poNumber       String?
  customerName   String
  /// Spruce's delivery report does not distinguish a contractor sale from a
  /// walk-in, and the importer stamped CONTRACTOR on every row — so the B2C
  /// side of the business appeared nowhere. Defaulted rather than asserted:
  /// B2B is roughly 90% of volume, so this is the right guess, but it is a
  /// default to be corrected, not a fact read off the report.
  buyerType      BuyerType?         @default(CONTRACTOR)
  product        String
  quantity       Decimal?           @db.Decimal
  unit           String?
  supplierId     String?            @db.Uuid
  orderDate      DateTime           @db.Date
  deliveryDate   DateTime?          @db.Date
  hasInvoice     Boolean            @default(false)
  invoiceNumber  String?
  createdAt      DateTime           @default(now())
  deliveryStatus DriverTaskStatus   @default(NOT_STARTED)
  driverId       String?            @db.Uuid
  priority       Int                @default(1)
  deliveries     Delivery[]
  lineItems      InvoiceLineItem[]
  driver         Driver?            @relation(fields: [driverId], references: [id])
  supplier       Supplier?          @relation(fields: [supplierId], references: [id])
  document       OrderDocument?     @relation(fields: [documentId], references: [id])
  tickets        Ticket[]
  ticketMatches  TicketOrderMatch[]

  /// The identity a re-import reconciles on, once the document layer is
  /// populated. `lineNumber` is display order, not identity.
  @@unique([documentId, lineNumber])
  @@index([poNumber])
  @@index([supplierId])
  @@index([orderDate])
  @@index([documentId])
  @@index([spruceItemNumber])
}


model Ticket {
  id                      String             @id @default(uuid()) @db.Uuid
  ticketNumber            String?
  source                  TicketSource
  supplierId              String?            @db.Uuid
  supplierName            String?
  poNumber                String?
  material                String?
  quantity                Decimal?           @db.Decimal
  unit                    String?
  rateOnTicket            Decimal?           @db.Decimal
  ticketDate              DateTime?          @db.Date
  imageUrl                String
  /// Small derived WebP for list/mobile rendering. Nullable: generation is
  /// best-effort and must never block a proof-of-delivery upload. Null means
  /// "not generated yet" and the UI falls back to imageUrl.
  thumbnailUrl            String?
  ocrRawText              String
  ocrConfidence           Float
  linkedOrderId           String?            @db.Uuid
  linkMethod              String?
  linkedById              String?            @db.Uuid
  status                  TicketStatus
  receivedAt              DateTime           @default(now())
  driverId                String?            @db.Uuid
  deliveryStatus          DriverTaskStatus   @default(NOT_STARTED)
  spruceMatched           Boolean            @default(false)
  ocrJobs                 OcrJob[]           @relation("TicketOcrJobs")
  driver                  Driver?            @relation(fields: [driverId], references: [id])
  linkedBy                User?              @relation(fields: [linkedById], references: [id])
  linkedOrder             Order?             @relation(fields: [linkedOrderId], references: [id])
  supplier                Supplier?          @relation(fields: [supplierId], references: [id])
  orderMatches            TicketOrderMatch[]
  matchedInvoiceLineItems InvoiceLineItem[]  @relation("InvoiceLineItemToTicket")

  @@index([status])
  @@index([poNumber])
  @@index([supplierId])
  @@index([receivedAt])
  // The list screen filters on status and sorts by receivedAt desc, a shape a
  // single-column index does not support. Effect on the query plan is
  // unverified — no EXPLAIN ANALYZE was captured.
  @@index([status, receivedAt(sort: Desc)])
  @@index([supplierId, receivedAt(sort: Desc)])
}


model TicketOrderMatch {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  orderId     String   @db.Uuid
  matchMethod String
  matchedAt   DateTime @default(now())
  createdBy   String?  @db.Uuid
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@unique([ticketId, orderId])
  @@index([matchMethod])
  @@index([orderId])
  @@index([ticketId])
}

model Invoice {
  id             String               @id @default(uuid()) @db.Uuid
  invoiceNumber  String
  senderType     SenderType
  supplierId     String               @db.Uuid
  invoiceDate    DateTime             @db.Date
  dueDate        DateTime?            @db.Date
  totalAmount    Decimal              @db.Decimal
  currency       String
  fileUrl        String
  emailFrom      String
  emailSubject   String
  gmailMessageId String               @unique
  status         InvoiceStatus        @default(PENDING_REVIEW)
  verifiedById   String?              @db.Uuid
  verifiedAt     DateTime?
  disputeNote    String?
  receivedAt     DateTime             @default(now())
  ocrRawText     String?
  OcrJobStatus   OcrJobStatus         @default(PENDING)
  emailEvent     EmailIngestionEvent?
  supplier       Supplier             @relation(fields: [supplierId], references: [id])
  verifiedBy     User?                @relation(fields: [verifiedById], references: [id])
  lineItems      InvoiceLineItem[]
  ocrJobs        OcrJob[]             @relation("InvoiceOcrJobs")

  @@index([status])
  @@index([supplierId])
  @@index([receivedAt])
  // Same filter+sort shape as Ticket: the invoice list filters on status and
  // orders by receivedAt desc.
  @@index([status, receivedAt(sort: Desc)])
}


model InvoiceLineItem {
  id              String       @id @default(uuid()) @db.Uuid
  invoiceId       String       @db.Uuid
  lineNumber      Int
  poNumber        String?
  description     String
  quantity        Decimal      @db.Decimal
  unit            String
  unitRate        Decimal      @db.Decimal
  lineTotal       Decimal      @db.Decimal
  matchedOrderId  String?      @db.Uuid
  negotiatedRate  Decimal?     @db.Decimal
  rateDiscrepancy Decimal?     @db.Decimal
  qtyDiscrepancy  Decimal?     @db.Decimal
  approvedTotal   Decimal?     @db.Decimal
  flag            LineItemFlag
  isOverridden    Boolean      @default(false)
  overrideNote    String?
  invoice         Invoice      @relation(fields: [invoiceId], references: [id])
  matchedOrder    Order?       @relation(fields: [matchedOrderId], references: [id])
  matchedTickets  Ticket[]     @relation("InvoiceLineItemToTicket")

  @@index([invoiceId])
  @@index([poNumber])
}


model NegotiatedRate {
  id            String    @id @default(uuid()) @db.Uuid
  supplierId    String    @db.Uuid
  productName   String
  rate          Decimal   @db.Decimal
  unit          String
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  notes         String?
  createdById   String    @db.Uuid
  createdAt     DateTime  @default(now())
  createdBy     User      @relation(fields: [createdById], references: [id])
  supplier      Supplier  @relation(fields: [supplierId], references: [id])
}

model Supplier {
  id              String                @id @default(uuid()) @db.Uuid
  name            String
  type            SupplierType
  emailDomains    String[]
  contactName     String?
  contactEmail    String?
  phone           String?
  address         String?
  active          Boolean               @default(true)
  keywords        String[]
  /// The vendor codes Spruce prints on its reports for this supplier, e.g.
  /// `BESTWAYS01`. Reports name vendors by code, not by the supplier's stored
  /// name, so matching one against the other guessed wrong; this mapping is
  /// recorded once by a person and is exact thereafter.
  spruceVendors   SupplierSpruceVendor[]
  emailEvents     EmailIngestionEvent[]
  invoices        Invoice[]
  negotiatedRates NegotiatedRate[]
  orders          Order[]
  productAliases  SupplierProductAlias[]
  tickets         Ticket[]
}

/// Maps a Spruce vendor code to the supplier it bills as.
///
/// The item-tracking report names the vendor as a code (`BESTWAYS01`,
/// `UNILOCKL01`), which matches no supplier's stored name, so every such line
/// imported with no supplier at all — and invoice matching, which needs both
/// PO and supplier, never fired. A person records the code once; the importer
/// resolves it exactly or leaves the line unlinked and says so.
model SupplierSpruceVendor {
  code       String   @id
  supplierId String   @db.Uuid
  /// Retired codes are kept but no longer resolve, so an old report
  /// re-imported after a supplier change cannot silently re-point at it.
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  @@index([supplierId])
}

/// Maps the wording a supplier prints on their paperwork to the product name
/// used in that supplier's negotiated rates.
///
/// Rates were matched to invoice lines by string similarity, where a 0.6 score
/// or a substring hit counted as the same product. "A Gravel" and "B Gravel"
/// score far above that, so the wrong rate could be applied to real money. An
/// alias is recorded once by a person and is exact thereafter; fuzzy matching
/// stays only as the fallback for text nobody has mapped yet.
model SupplierProductAlias {
  id          String   @id @default(uuid()) @db.Uuid
  supplierId  String   @db.Uuid
  /// Supplier's wording, normalised (lower case, punctuation collapsed).
  aliasText   String
  /// Must equal a NegotiatedRate.productName for the same supplier.
  productName String
  createdAt   DateTime @default(now())
  createdById String?  @db.Uuid
  supplier    Supplier @relation(fields: [supplierId], references: [id])

  @@unique([supplierId, aliasText])
  @@index([supplierId])
}

model User {
  name             String
  email            String            @unique
  active           Boolean           @default(true)
  createdAt        DateTime          @default(now())
  passwordHash     String
  phone            String?
  role             UserRole
  id               String            @id @default(uuid()) @db.Uuid
  auditLogs        AuditLog[]
  verifiedInvoices Invoice[]
  createdRates     NegotiatedRate[]
  spruceImports    SpruceImportJob[]
  systemSettings   SystemSetting[]
  linkedTickets    Ticket[]
  driver           Driver?
}

model Driver {
  id              String            @id @default(uuid()) @db.Uuid
  name            String
  phone           String            @unique
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  email           String?           @unique
  ratePerDelivery Decimal           @default(0) @db.Decimal
  ratePerTrip     Decimal?          @db.Decimal
  type            DriverType        @default(CGC_FLEET)
  companyName     String?
  deliveries      Delivery[]
  orders          Order[]
  tickets         Ticket[]
  messages        WhatsAppMessage[]
  userId          String?           @db.Uuid @unique
  user            User?             @relation(fields: [userId], references: [id])
}

model Delivery {
  id               String            @id @default(uuid()) @db.Uuid
  orderId          String            @db.Uuid
  driverId         String?           @db.Uuid
  status           DeliveryStatus    @default(UNASSIGNED)
  priority         Int               @default(1)
  pickupType       String            @default("EXTERNAL")
  pickupPhotoUrl   String?
  deliveryPhotoUrl String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime          @default(now())
  driver           Driver?           @relation(fields: [driverId], references: [id])
  order            Order             @relation(fields: [orderId], references: [id])
  history          DeliveryHistory[]
}

model AuditLog {
  id            String          @id @default(uuid()) @db.Uuid
  entityType    AuditEntityType
  entityId      String
  actionType    AuditActionType
  performedById String?         @db.Uuid
  details       Json?
  createdAt     DateTime        @default(now())
  performedBy   User?           @relation(fields: [performedById], references: [id])
}

model SpruceImportJob {
  id           String                 @id @default(uuid()) @db.Uuid
  uploadedById String                 @db.Uuid
  fileUrl      String
  startedAt    DateTime               @default(now())
  finishedAt   DateTime?
  status       ImportStatus           @default(PENDING)
  totalRows    Int                    @default(0)
  createdCount Int                    @default(0)
  updatedCount Int                    @default(0)
  unchangedCount Int                  @default(0)
  absentCount  Int                    @default(0)
  conflictCount Int                   @default(0)
  skippedCount Int                    @default(0)
  errorSummary String?
  uploadedBy   User                   @relation(fields: [uploadedById], references: [id])
  rowErrors    SpruceImportRowError[]
}

model SpruceImportRowError {
  id           String          @id @default(uuid()) @db.Uuid
  importJobId  String          @db.Uuid
  rowNumber    Int
  rawRowData   String
  errorMessage String
  importJob    SpruceImportJob @relation(fields: [importJobId], references: [id])
}

model OcrJob {
  id           String       @id @default(uuid()) @db.Uuid
  provider     OcrProvider
  startedAt    DateTime?
  finishedAt   DateTime?
  errorMessage String?
  rawResponse  Json?
  ticketId     String?      @db.Uuid
  invoiceId    String?      @db.Uuid
  type         OcrJobType
  status       OcrJobStatus @default(PENDING)
  /// How many times this job has been attempted. The worker only picked up
  /// PENDING jobs, so a single Textract timeout left the document FAILED and
  /// unprocessed forever, with nothing on any screen to say so.
  attempts     Int          @default(0)
  /// Earliest time the worker may try again; spaces out retries after a failure.
  nextAttemptAt DateTime?
  invoice      Invoice?     @relation("InvoiceOcrJobs", fields: [invoiceId], references: [id])
  ticket       Ticket?      @relation("TicketOcrJobs", fields: [ticketId], references: [id])

  /// The worker's claim query: status plus when the job is next due.
  @@index([status, nextAttemptAt])
}

model EmailIngestionEvent {
  id                 String               @id @default(uuid()) @db.Uuid
  gmailMessageId     String               @unique
  subject            String
  fromAddress        String
  toAddress          String
  supplierId         String?              @db.Uuid
  senderTypeResolved SenderTypeResolved?
  createdInvoiceId   String?              @unique @db.Uuid
  createdTicketIds   String[]
  status             EmailIngestionStatus @default(PROCESSED)
  errorMessage       String?
  receivedAt         DateTime             @default(now())
  createdInvoice     Invoice?             @relation(fields: [createdInvoiceId], references: [id])
  supplier           Supplier?            @relation(fields: [supplierId], references: [id])
}

model WhatsAppMessage {
  id           String                @id @default(uuid()) @db.Uuid
  driverId     String?               @db.Uuid
  fromPhone    String
  messageId    String
  messageType  WhatsAppMessageType
  mediaUrl     String?
  rawPayload   Json
  status       WhatsAppMessageStatus @default(PROCESSED)
  errorMessage String?
  receivedAt   DateTime              @default(now())
  driver       Driver?               @relation(fields: [driverId], references: [id])
}

model SystemSetting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @default(now())
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}

model Product {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
  unit      String   @default("ton")
}

model Unit {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now())
}

model DeliveryHistory {
  id         String         @id @default(uuid()) @db.Uuid
  deliveryId String         @db.Uuid
  status     DeliveryStatus
  notes      String?
  createdAt  DateTime       @default(now())
  delivery   Delivery       @relation(fields: [deliveryId], references: [id])
}

enum BuyerType {
  RETAIL
  CONTRACTOR
}

enum TicketSource {
  WHATSAPP
  EMAIL
  MANUAL
}

enum TicketStatus {
  UNLINKED
  LINKED
  REVIEWED
}

enum LinkMethod {
  AUTO
  MANUAL
}

enum SenderType {
  SUPPLIER
  TRUCKING_COMPANY
}

enum InvoiceStatus {
  PENDING_REVIEW
  VERIFIED
  DISPUTED
  PAID
}

enum LineItemFlag {
  OK
  RATE_MISMATCH
  QTY_MISMATCH
  NO_TICKET
  NO_ORDER
  RATE_UNKNOWN
  // An agreed rate was found, but it is priced per a different unit than the
  // invoice line, so the two numbers cannot be compared. Distinct from
  // RATE_UNKNOWN, where no rate was found at all: this one is resolved by
  // correcting a unit, not by adding a rate.
  UNIT_MISMATCH
  MULTIPLE_FLAGS
}

enum SupplierType {
  SUPPLIER
  TRUCKING_COMPANY
}

enum UserRole {
  AP_USER
  OWNER
  ADMIN
  DRIVER
}

enum OcrJobType {
  TICKET
  INVOICE
}

enum OcrProvider {
  GOOGLE_VISION
  AWS_TEXTRACT
}

enum OcrJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum AuditEntityType {
  INVOICE
  TICKET
  ORDER
  SUPPLIER
  RATE
  SYSTEM
}

enum AuditActionType {
  INVOICE_VERIFIED
  INVOICE_DISPUTED
  INVOICE_REOPENED
  TICKET_LINKED
  TICKET_REVIEWED
  RATE_CREATED
  RATE_UPDATED
  EMAIL_INGESTION_ERROR
  WHATSAPP_WEBHOOK_ERROR
  OCR_RETRY
  SYSTEM_CONFIG_CHANGE
  INVOICE_LINE_OVERRIDDEN
}

enum ImportStatus {
  PENDING
  PROCESSING
  /// Finished with some rows imported and some refused; see the row errors.
  PARTIAL
  COMPLETED
  FAILED
}

enum EmailIngestionStatus {
  PROCESSED
  FAILED
}

enum SenderTypeResolved {
  SUPPLIER
  TRUCKING_COMPANY
  UNKNOWN
}

enum WhatsAppMessageType {
  IMAGE
  TEXT
  OTHER
}

enum WhatsAppMessageStatus {
  PROCESSED
  IGNORED
  FAILED
}

enum DriverTaskStatus {
  NOT_STARTED
  AT_SUPPLIER
  IN_TRANSIT
  COMPLETED
}

enum DriverType {
  CGC_FLEET
  INDEPENDENT
}

enum DeliveryStatus {
  UNASSIGNED
  PLACED
  OUT_FOR_DELIVERY
  IN_TRANSIT
  DELIVERED
  ON_HOLD
  DELAYED
  CANCELLED
}
